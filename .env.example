# Frontend Environment Variables
# Copy this to .env and fill in values

# API URL
# Development: http://localhost:5001
# Production: leave empty (nginx proxies /api to backend)
# Vercel frontend + separate backend clone: https://your-backend-host.com
VITE_API_URL=http://localhost:5001

# Encryption key for secure localStorage (optional - has fallback)
VITE_ENCRYPTION_KEY=your-secure-encryption-key-here

# Google Analytics 4 Measurement ID
# Get from: https://analytics.google.com > Admin > Data Streams > your stream
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Web Push VAPID Public Key
# Generate with: npx web-push generate-vapid-keys
# Must match the VAPID_PUBLIC_KEY in backend/.env
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
